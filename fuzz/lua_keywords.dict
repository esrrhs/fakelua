# Lua keyword dictionary for libFuzzer
# Format: "keyword" or key_hex="hexbytes"
# libFuzzer uses these tokens as building blocks during mutation,
# helping it generate syntactically valid Lua fragments faster.

# Keywords
"and"
"break"
"do"
"else"
"elseif"
"end"
"false"
"for"
"function"
"goto"
"if"
"in"
"local"
"nil"
"not"
"or"
"repeat"
"return"
"then"
"true"
"until"
"while"

# Operators
"+"
"-"
"*"
"/"
"%"
"^"
"#"
"=="
"~="
"<="
">="
"<"
">"
"="
"("
")"
"{"
"}"
"["
"]"
"."
","
":"
";"
".."
"..."

# Common literals
"0"
"1"
"2"
"10"
"100"
"0.5"
"-1"
"\"\""
"\"a\""
"\"hello\""
"{}"
"{1,2,3}"

# Common patterns
"local a = 1"
"local t = {}"
"function f()"
"return 0"
"for i=1,10 do"
"if true then"
"while false do"
